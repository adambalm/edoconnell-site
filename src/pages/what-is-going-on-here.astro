---
/*
 * DRAFT-FOR-ED — "What is going on here?" — the site's orientation page.
 * Supersedes /governed-fleet/ as orientation (Ed's ruling, 2026-07-25);
 * the fleet page is kept as history with a pointer forward.
 * Rebuilt after Ed's correction 2026-07-25: the page must DO the
 * orientation work, not assign it — show the three kinds with real links
 * and live status stamps, one ask line, one door. Design speaks in the
 * site's existing idiom (display italic lede, card grid, kind dots,
 * mono stamps). Voice is Ed's, drafted for his review; the visible
 * draft stamp comes off only on his approval.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import MarkNote from '../components/MarkNote.astro'

export const prerender = true

const kinds = [
  {
    key: 'work',
    title: 'Work',
    line: 'Systems in daily use at the school that hired me to modernize it.',
    links: [
      { label: 'The school platform', href: '/case-studies/sca-headless-cms/', stamp: 'running · checked Jul 24' },
      { label: 'Enrollment automations', href: '/next/enrollment-automations/', stamp: 'in daily use' },
    ],
  },
  {
    key: 'craft',
    title: 'Craft',
    line: 'Experiments I run to learn tools from the inside.',
    links: [
      { label: 'Handwriting pipeline', href: '/next/handwriting-pipeline/', stamp: 'working' },
      { label: 'Talking character', href: '/next/talking-character/', stamp: 'experiment' },
    ],
  },
  {
    key: 'thought',
    title: 'Thought',
    line: 'Essays, written slowly.',
    links: [
      { label: 'The Bike Shop', href: '/articles/the-bike-shop/', stamp: 'published' },
    ],
  },
]
---

<BaseLayout
  title="What is going on here?"
  description="One person practicing what he preaches: content systems, AI tooling, and statuses you can check."
>
  <div class="wigoh">
    <p class="draft-stamp">draft · under review</p>

    <header data-mark="wigoh:masthead">
      <h1>What is going on here?</h1>
      <p class="lede">One person, practicing what he preaches. Or at least trying.</p>
      <p class="intro">
        I build content systems and AI tooling for institutions — and run everything I
        recommend, here, in the open. Every status below is real and dated.
      </p>
    </header>

    <section class="kinds" aria-label="The three kinds of things here">
      {kinds.map((k) => (
        <div class={`card ${k.key}`} data-mark={`wigoh:${k.key}`}>
          <h2>{k.title}</h2>
          <p>{k.line}</p>
          <ul>
            {k.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
                <span class="stamp">{l.stamp}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <p class="more" data-mark="wigoh:more">
      The full index — years, stacks, statuses — is at <a href="/next/">the index</a>.
      Proof that outlasts me: <a href="https://magazine.wne.edu">magazine.wne.edu</a>
      <span class="stamp">still running · checked Jul 24</span>
    </p>

    <section class="band ask" data-mark="wigoh:ask">
      <p class="band-action"><a href="/next/archive/">Ask the archive about any of this &rarr;</a></p>
      <p class="band-sub">A chat that answers from what I've reviewed — and refers the rest to me.</p>
    </section>

    <section class="band door" data-mark="wigoh:door">
      <p class="band-action"><a href="/contact/">Hiring, contracting, or just curious &rarr;</a></p>
      <p class="band-sub">espoconnell@gmail.com &middot; I answer my own mail.</p>
    </section>

    <footer class="lineage" data-mark="wigoh:lineage">
      <p>
        Supersedes <a href="/governed-fleet/">"The Fleet"</a> as this site's orientation —
        that page is kept, as history should be. Agents: <a href="/llms.txt">/llms.txt</a>.
      </p>
    </footer>
  </div>
  <MarkNote />
</BaseLayout>

<style>
  .wigoh {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-12) var(--page-gutter) var(--space-24);
  }
  .draft-stamp {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-8);
  }
  h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-3xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-2);
    text-wrap: balance;
  }
  .lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--font-size-xl);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-4);
    text-wrap: balance;
  }
  .intro {
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
    max-width: var(--measure);
    margin: 0 0 var(--space-12);
  }
  .kinds {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  @media (max-width: 720px) {
    .kinds { grid-template-columns: 1fr; }
  }
  .card {
    border: 1px solid var(--color-bg-subtle);
    border-radius: 6px;
    padding: var(--space-5) var(--space-5) var(--space-4);
  }
  .card h2 {
    font-family: var(--font-ui);
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 var(--space-2);
  }
  .card h2::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 0.55em;
    vertical-align: 1px;
    background: var(--color-text-muted);
  }
  .card.work h2::before { background: var(--color-cat-case-study, #0f6e66); }
  .card.craft h2::before { background: var(--color-cat-essay, #8a5212); }
  .card.thought h2::before { background: var(--color-cat-brief, #1d4e89); }
  .card p {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin: 0 0 var(--space-4);
  }
  .card ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .card li {
    display: block;
    padding: var(--space-2) 0;
    border-top: 1px solid var(--color-bg-subtle);
  }
  .card li .stamp {
    display: block;
    margin-top: 2px;
  }
  .stamp {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .more {
    margin: var(--space-8) 0 var(--space-12);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .more .stamp { margin-left: var(--space-2); }
  .band {
    border-top: 1px solid var(--color-text);
    padding: var(--space-6) 0;
  }
  .band.door { border-top: 1px solid var(--color-bg-subtle); }
  .band-action {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-1);
    text-wrap: balance;
  }
  .band-action a { text-decoration: none; }
  .band-action a:hover { text-decoration: underline; }
  .band-sub {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: 0;
  }
  .lineage {
    margin-top: var(--space-16);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-bg-subtle);
  }
  .lineage p {
    font-family: var(--font-ui);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
