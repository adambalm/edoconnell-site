---
/* DRAFT-FOR-ED — candidate node page, /next preview namespace. */
import BaseLayout from '../../layouts/BaseLayout.astro'
import MarkNote from '../../components/MarkNote.astro'

export const prerender = true
---

<BaseLayout
  title="Classroom intelligence"
  description="A design for giving teachers a structured, private view of student progress."
>
  <article class="node">
    <p class="draft-stamp">draft · under review</p>
    <header data-mark="ci:masthead">
      <h1>Classroom intelligence</h1>
      <p class="dek">A teacher's structured, private view of what is happening in their classroom.</p>
      <p class="meta">work · designed · Gemini, NotebookLM</p>
    </header>

    <section data-mark="ci:what">
      <h2>The design</h2>
      <p>
        Teachers accumulate knowledge about students all year — in graded work, in
        notes, in conversation — and almost none of it is queryable when a decision
        needs it. This design pairs two tools teachers already have: a customized Gemini
        assistant configured for the teacher's own questions, and NotebookLM notebooks
        holding the classroom's actual records as sources. The assistant answers from
        the notebook, not from the open internet, so answers stay grounded in what the
        class actually produced.
      </p>
      <p>
        Student privacy is the constraint the whole design bends around: records stay in
        the school's own workspace, nothing trains a public model, and the design is on
        hold for production use until counsel signs off on handling real student data.
        Status: designed, argued for on paper, not deployed.
      </p>
    </section>
  </article>
  <MarkNote />
</BaseLayout>

<style>
  .node {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-12) var(--page-gutter) var(--space-24);
  }
  .draft-stamp {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-8);
  }
  h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-3);
  }
  .dek {
    font-size: var(--font-size-md);
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-2);
  }
  .meta {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-8);
  }
  h2 {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    margin: var(--space-8) 0 var(--space-4);
  }
  p {
    line-height: var(--leading-normal);
    margin: 0 0 var(--space-4);
  }
</style>
