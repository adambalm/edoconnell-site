---
/*
 * DRAFT-FOR-ED — the "ask the archive" testbed, /next preview namespace.
 * This is the interview-proxy's intake half, working today: questions are
 * captured to the feedback log (the deferral loop's first stage). The
 * answering half arrives later, scoped per resume-factory/DESIGN.md.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'

export const prerender = false
---

<BaseLayout
  title="Ask the archive"
  description="Ask a question about the work on this site."
>
  <article class="ask">
    <p class="draft-stamp">draft · being built</p>
    <header data-mark="archive:masthead">
      <h1>Ask the archive</h1>
      <p class="dek">Ask about the work on this site.</p>
    </header>

    <form id="ask-form" data-mark="archive:form">
      <label for="ask-q" class="sr-only">Your question</label>
      <textarea id="ask-q" required maxlength="1000" placeholder="What would you like to know?"></textarea>
      <button type="submit">Ask</button>
    </form>

    <div id="ask-thread" class="thread"></div>
  </article>
</BaseLayout>

<script>
  const form = document.getElementById('ask-form') as HTMLFormElement
  const q = document.getElementById('ask-q') as HTMLTextAreaElement
  const thread = document.getElementById('ask-thread')!
  const history: { role: 'user' | 'assistant'; content: string }[] = []

  function add(cls: string, text: string) {
    const div = document.createElement('div')
    div.className = `turn ${cls}`
    div.textContent = text
    thread.appendChild(div)
    div.scrollIntoView({ block: 'nearest' })
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const text = q.value.trim()
    if (!text) return
    add('q', text)
    q.value = ''
    add('pending', '\u2026')
    const pending = thread.lastElementChild!
    try {
      const res = await fetch('/api/archive-ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question: text, history }),
      })
      const data = await res.json()
      pending.remove()
      if (data.answer) {
        add('a', data.answer)
        history.push({ role: 'user', content: text })
        history.push({ role: 'assistant', content: data.answer })
        if (history.length > 12) history.splice(0, history.length - 12)
      } else {
        add('defer', 'The answering model is offline right now. Your question is saved for Ed.')
      }
    } catch {
      pending.remove()
      add('defer', 'Send failed \u2014 your question was not saved. Try again.')
    }
    q.focus()
  })
</script>

<style>
  .ask {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-12) var(--page-gutter) var(--space-24);
  }
  .draft-stamp {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-8);
  }
  h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-3);
  }
  .dek {
    font-size: var(--font-size-md);
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-8);
  }
  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 34rem;
  }
  textarea {
    min-height: 5em;
    font-family: var(--font-ui);
    font-size: var(--font-size-sm);
    color: var(--color-text);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-text-muted);
    border-radius: 2px;
    padding: 0.7em;
  }
  button {
    align-self: flex-start;
    font-family: var(--font-ui);
    font-size: var(--font-size-sm);
    padding: 0.45em 1.4em;
    border-radius: 2px;
    cursor: pointer;
    border: 1px solid var(--color-accent, #8b2635);
    background: var(--color-accent, #8b2635);
    color: var(--color-bg);
  }
  .thread {
    margin-top: var(--space-8);
    max-width: 34rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .turn {
    line-height: var(--leading-normal);
    font-size: var(--font-size-sm);
  }
  .turn.q {
    font-family: var(--font-ui);
    color: var(--color-text-muted);
    border-left: 1px solid var(--color-text-muted);
    padding-left: var(--space-4);
  }
  .turn.a {
    font-family: var(--font-prose);
    font-size: var(--font-size-base);
  }
  .turn.defer,
  .turn.pending {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
