---
/*
 * DRAFT-FOR-ED — the "ask the archive" conversation, /next namespace.
 * Layout copies the dominant chat convention (ChatGPT/Claude.ai): empty
 * state centers the composer with starter chips; once conversation starts,
 * the composer docks to the bottom, the thread fills the viewport, user
 * messages sit right-aligned, and streaming auto-follows unless the reader
 * scrolls up. Mobile: dynamic viewport units, 16px input font (no iOS zoom),
 * safe-area padding. Route + limits: src/pages/api/archive-ask.ts; corpus:
 * src/config/archive-bot.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import { MODELS, DEFAULT_MODEL_KEY } from '../../config/archive-bot'

export const prerender = false

const ollamaAvailable = Boolean(process.env.OLLAMA_BASE_URL ?? import.meta.env.OLLAMA_BASE_URL)
const modelOptions = MODELS.filter((m) => m.provider === 'anthropic' || ollamaAvailable)

const starters = [
  'What has Ed actually built?',
  'How does the handwriting pipeline work?',
  'What was the AI summer camp about?',
  'How does this chatbot itself work?',
]
---

<BaseLayout
  title="Ask the archive"
  description="A conversation about Ed O'Connell's work — grounded in the record."
>
  <article class="ask" id="ask-root">
    <div class="intro">
      <p class="draft-stamp">draft · under review</p>
      <h1>Ask the archive</h1>
      <p class="dek">Questions about Ed's work, answered from the record.</p>
    </div>

    <div id="ask-thread" class="thread" aria-live="polite"></div>

    <div class="composer">
      <div id="ask-starters" class="starters" data-mark="archive:starters">
        {starters.map((s) => (
          <button type="button" class="starter" data-q={s}>{s}</button>
        ))}
      </div>
      <form id="ask-form" data-mark="archive:form">
        <label for="ask-q" class="sr-only">Your question</label>
        <textarea
          id="ask-q"
          required
          maxlength="1000"
          rows="1"
          placeholder="Ask about the work…"
        ></textarea>
        <button type="submit" id="ask-send" aria-label="Send question">Ask</button>
      </form>
      <p class="hint">
        <label for="ask-model" class="sr-only">Answering model</label>
        <select id="ask-model">
          {modelOptions.map((m) => (
            <option value={m.key} selected={m.key === DEFAULT_MODEL_KEY}>{m.label}</option>
          ))}
        </select>
        <span class="hint-keys">Enter to send · Shift+Enter for a new line</span>
      </p>
    </div>
  </article>
</BaseLayout>

<script>
  const root = document.getElementById('ask-root')!
  const form = document.getElementById('ask-form') as HTMLFormElement
  const q = document.getElementById('ask-q') as HTMLTextAreaElement
  const sendBtn = document.getElementById('ask-send') as HTMLButtonElement
  const thread = document.getElementById('ask-thread')!
  const startersBox = document.getElementById('ask-starters')!
  const modelSel = document.getElementById('ask-model') as HTMLSelectElement
  if (new URLSearchParams(location.search).has('dev')) localStorage.setItem('archive-dev', '1')
  const devMode = localStorage.getItem('archive-dev') === '1'
  const RS = String.fromCharCode(30)
  const history: { role: 'user' | 'assistant'; content: string }[] = []
  let busy = false

  function nearBottom(): boolean {
    return thread.scrollTop + thread.clientHeight >= thread.scrollHeight - 80
  }
  function follow(force = false) {
    if (force || nearBottom()) thread.scrollTop = thread.scrollHeight
  }

  // After streaming completes, upgrade known-safe site paths and the contact
  // email to real links. Only exact allowlisted patterns — never arbitrary URLs.
  function renderLinks(el: HTMLElement, text: string) {
    const safe = /(\/(?:contact|next\/[a-z-]+|articles\/[a-z-]+|case-studies\/[a-z-]+|governed-fleet)\/?)|((?:https:\/\/)?magazine\.wne\.edu)|(espoconnell@gmail\.com)|((?:https:\/\/)?linkedin\.com\/in\/espoconnell)/g
    if (!safe.test(text)) return
    el.textContent = ''
    let last = 0
    safe.lastIndex = 0
    for (let m; (m = safe.exec(text)); ) {
      el.appendChild(document.createTextNode(text.slice(last, m.index)))
      const a = document.createElement('a')
      const hit = m[0]
      a.textContent = hit
      if (hit.includes('@')) a.href = `mailto:${hit}`
      else if (hit.startsWith('/')) a.href = hit
      else a.href = hit.startsWith('https://') ? hit : `https://${hit}`
      if (!hit.startsWith('/')) a.rel = 'noopener'
      el.appendChild(a)
      last = m.index + hit.length
    }
    el.appendChild(document.createTextNode(text.slice(last)))
  }

  function turn(cls: string): HTMLElement {
    const wrap = document.createElement('div')
    wrap.className = `turn ${cls}`
    const body = document.createElement('div')
    body.className = 'body'
    if (cls === 'a') {
      const label = document.createElement('span')
      label.className = 'who'
      label.textContent = 'Archive'
      wrap.append(label)
    }
    wrap.append(body)
    thread.appendChild(wrap)
    return body
  }

  function setBusy(b: boolean) {
    busy = b
    sendBtn.disabled = b
    q.disabled = b
  }

  async function ask(text: string) {
    if (busy || !text) return
    root.classList.add('started')
    startersBox.remove()
    setBusy(true)
    turn('q').textContent = text
    q.value = ''
    q.style.height = 'auto'

    const aBody = turn('a')
    aBody.classList.add('thinking')
    aBody.innerHTML = '<span class="dot"></span><span class="dot"></span><span class="dot"></span>'
    follow(true)
    const slowNote = setTimeout(() => {
      if (aBody.classList.contains('thinking')) {
        aBody.parentElement!.querySelector('.who')!.textContent = 'Archive · still thinking'
      }
    }, 4000)
    const watchdog = setTimeout(() => {
      if (aBody.classList.contains('thinking')) {
        aBody.classList.remove('thinking')
        aBody.textContent =
          'No response after two minutes — that model may be overloaded. Try a Claude model from the picker; your question is saved either way.'
        aBody.parentElement!.querySelector('.who')!.textContent = 'Archive'
      }
    }, 125000)

    let answer = ''
    try {
      const res = await fetch('/api/archive-ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question: text, history, model: modelSel?.value }),
      })

      if (res.status === 429) {
        aBody.classList.remove('thinking')
        aBody.textContent = 'The archive is getting a lot of questions right now — try again in a minute.'
        return
      }

      const type = res.headers.get('content-type') ?? ''
      if (type.includes('application/json')) {
        const data = await res.json()
        aBody.classList.remove('thinking')
        aBody.textContent = data.unavailable
          ? 'The answering model is offline right now. The question was saved for Ed.'
          : 'Something went wrong — try again.'
        return
      }

      const reader = res.body!.getReader()
      const dec = new TextDecoder()
      let raw = ''
      for (;;) {
        const { done, value } = await reader.read()
        if (done) break
        if (aBody.classList.contains('thinking')) {
          aBody.classList.remove('thinking')
          aBody.textContent = ''
          aBody.parentElement!.querySelector('.who')!.textContent = 'Archive'
        }
        raw += dec.decode(value, { stream: true })
        answer = raw.split(RS)[0]
        aBody.textContent = answer
        follow()
      }
      renderLinks(aBody, answer)
      const tail = raw.split(RS)[1]
      if (tail) {
        try {
          const u = JSON.parse(tail)
          if (u.truncated) {
            const note = document.createElement('p')
            note.className = 'trunc-note'
            note.textContent = '— the answer hit its length cap'
            aBody.parentElement!.appendChild(note)
          }
          if (devMode) {
            const meta = document.createElement('p')
            meta.className = 'usage-line'
            meta.textContent = `${u.model} · ${u.in}→${u.out} tok · $${u.cost.toFixed(4)} · ${(u.ms / 1000).toFixed(1)}s`
            aBody.parentElement!.appendChild(meta)
          }
        } catch { /* no usage tail */ }
      }
      if (answer) {
        history.push({ role: 'user', content: text })
        history.push({ role: 'assistant', content: answer })
        if (history.length > 12) history.splice(0, history.length - 12)
      } else {
        aBody.classList.remove('thinking')
        aBody.textContent = 'No answer came back — try again.'
      }
    } catch {
      aBody.classList.remove('thinking')
      aBody.textContent = 'Send failed — check the connection and try again.'
    } finally {
      clearTimeout(slowNote)
      clearTimeout(watchdog)
      setBusy(false)
      q.focus()
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault()
    ask(q.value.trim())
  })

  q.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault()
      ask(q.value.trim())
    }
  })

  q.addEventListener('input', () => {
    q.style.height = 'auto'
    q.style.height = Math.min(q.scrollHeight, 160) + 'px'
  })

  startersBox.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('.starter') as HTMLElement | null
    if (b) ask(b.dataset.q ?? '')
  })

  q.focus()
</script>

<style is:global>
  /* App-shell frame: intro + thread + composer, sized to the real viewport */
  .ask {
    max-width: 46rem;
    margin: 0 auto;
    padding: 0 var(--page-gutter) env(safe-area-inset-bottom, 0);
    display: flex;
    flex-direction: column;
    height: calc(100vh - 5.5rem);
    height: calc(100dvh - 5.5rem);
    min-height: 20rem;
  }

  /* EMPTY STATE — composer centered in the viewport, chips above it */
  .ask .intro {
    text-align: center;
    margin-top: auto;
  }
  .ask .draft-stamp {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-2);
  }
  .ask h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-2);
  }
  .ask .dek {
    font-size: var(--font-size-sm);
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
  }
  .ask .composer {
    margin-bottom: auto;
    padding: var(--space-2) 0 var(--space-4);
  }

  /* STARTED STATE — intro collapses to one line, thread fills, composer docks */
  .ask.started .intro {
    margin: 0;
    text-align: left;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-bg-subtle);
  }
  .ask.started h1 {
    font-size: var(--font-size-md);
    display: inline;
    margin: 0 var(--space-3) 0 0;
  }
  .ask.started .dek { display: none; }
  .ask.started .draft-stamp {
    display: inline;
    margin: 0;
  }
  .ask.started .composer {
    margin: 0;
    border-top: 1px solid var(--color-bg-subtle);
    padding: var(--space-2) 0 var(--space-3);
  }

  .ask .thread {
    flex: 1 1 auto;
    overflow-y: auto;
    display: none;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-1) var(--space-4) 0;
    overscroll-behavior: contain;
  }
  .ask.started .thread { display: flex; }

  /* User turns right-aligned (the recognized convention); archive turns are prose */
  .ask .turn.q {
    align-self: flex-end;
    max-width: 85%;
  }
  .ask .turn.q .body {
    font-family: var(--font-ui);
    font-size: var(--font-size-sm);
    line-height: var(--leading-normal);
    background: var(--color-bg-subtle);
    border-radius: 8px;
    padding: var(--space-2) var(--space-4);
    white-space: pre-wrap;
  }
  .ask .turn.a {
    align-self: stretch;
    max-width: 100%;
  }
  .ask .turn.a .who {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }
  .ask .turn.a .body {
    font-family: var(--font-prose);
    font-size: var(--font-size-base);
    line-height: var(--leading-normal);
    white-space: pre-line;
  }

  .ask .thinking .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-text-muted);
    margin-right: 5px;
    animation: ask-pulse 1.2s ease-in-out infinite;
  }
  .ask .thinking .dot:nth-child(2) { animation-delay: 0.2s; }
  .ask .thinking .dot:nth-child(3) { animation-delay: 0.4s; }
  @keyframes ask-pulse {
    0%, 100% { opacity: 0.25; }
    50% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ask .thinking .dot { animation: none; opacity: 0.6; }
  }

  .ask .starters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .ask.started .starters { display: none; }
  .ask .starter {
    font-family: var(--font-ui);
    font-size: var(--font-size-sm);
    color: var(--color-text);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-text-muted);
    border-radius: 999px;
    padding: 0.5em 1em;
    cursor: pointer;
    min-height: 44px;
  }
  .ask .starter:hover {
    border-color: var(--color-accent, #8b2635);
    color: var(--color-accent, #8b2635);
  }

  .ask form {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
  }
  .ask textarea {
    flex: 1;
    font-family: var(--font-ui);
    font-size: 1rem; /* 16px floor — below this iOS zooms the page on focus */
    line-height: 1.45;
    color: var(--color-text);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-text-muted);
    border-radius: 8px;
    padding: 0.6em 0.9em;
    resize: none;
    max-height: 160px;
    min-height: 44px;
  }
  .ask textarea:disabled { opacity: 0.6; }
  .ask #ask-send {
    font-family: var(--font-ui);
    font-size: 1rem;
    padding: 0.5em 1.3em;
    min-height: 44px;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid var(--color-accent, #8b2635);
    background: var(--color-accent, #8b2635);
    color: var(--color-bg);
  }
  .ask #ask-send:disabled { opacity: 0.6; cursor: wait; }
  .ask .hint {
    font-family: var(--font-ui);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin: var(--space-2) 0 0;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }
  .ask .hint select {
    font-family: var(--font-ui);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    background: var(--color-bg);
    border: 1px solid var(--color-bg-subtle);
    border-radius: 4px;
    padding: 0.2em 0.4em;
  }
  .ask .usage-line,
  .ask .trunc-note {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin: var(--space-1) 0 0;
  }
  @media (hover: none) {
    .ask .hint-keys { display: none; } /* Enter-to-send hint is meaningless on touch */
  }
  .ask .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
